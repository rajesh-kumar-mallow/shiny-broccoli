{
  "name": "shiny-broccoli",
  "private": true,
  "version": "2026.06.25.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "node scripts/dev-local.mjs",
    "build:local": "HUBBLE_LOCAL_DEV=1 node scripts/build-userscripts.mjs && HUBBLE_LOCAL_DEV=1 node scripts/build-usercss.mjs",
    "build:userscript": "node scripts/build-userscripts.mjs",
    "build:stylus": "node scripts/build-usercss.mjs",
    "build": "npm run build:userscript && npm run build:stylus",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run check && npm run lint && npm run format:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@preact/preset-vite": "^2.10.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "preact": "^10.29.7",
    "prettier": "^3.8.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.0.5",
    "vite-plugin-monkey": "^5.0.3"
  }
}
